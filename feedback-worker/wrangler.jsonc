{
  "name": "guigui-feedback",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-01",
  // database_id 在 `wrangler d1 create guigui-feedback` 后填入
  "d1_databases": [
    { "binding": "DB", "database_name": "guigui-feedback", "database_id": "976cb746-1d0e-4dd1-b7f7-6893436a34ac" }
  ],
  // 只允许官网生产域调用;预览部署(file://、pages 预览链)自动走邮件兜底
  "vars": { "ALLOWED_ORIGIN": "https://guigui-guat.pages.dev" }
}
